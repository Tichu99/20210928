    // ========== 日志系统 ==========
    function log(...args) {
        const timestamp = new Date().toLocaleTimeString();
        const message = args.map(arg => {
            if (typeof arg === 'object') {
                try {
                    return JSON.stringify(arg);
                } catch {
                    return String(arg);
                }
            }
            return String(arg);
        }).join(' ');
        
        const fullMessage = `[${timestamp}] ${message}`;
        logs.push(fullMessage);
        if (logs.length > 150) logs.shift();
        
        if (CONFIG.debug) {
            console.log(`%c[川润通用版]`, 'background: #9C27B0; color: white; padding: 2px 5px; border-radius: 3px;', ...args);
        }
        
        updateLogPanel();
        
        return fullMessage;
    }
    
